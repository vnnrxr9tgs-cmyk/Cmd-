{
    "scan_interval": 10,
    "info_reports": [
        {
            "title": "📊 Краткий отчет (каждые 10 мин)",
            "interval_seconds": 20,
            "template": "Заказы: {test}\nСессии: {test2}"
        },
                {
            "title": "📊 Краткий отчет ( мин)",
            "interval_seconds": 17,
            "template": "Заказы: {test}\n {pending_orders}"
        },
        {
            "title": "📈 Часовой отчет",
            "interval_seconds": 3600,
            "template": "Системная статистика:\n\n• Pending Orders: {pending_orders}\n• Active Users: {active_users}\n• CPU Load: {cpu_usage}%\n• Memory: {memory_usage}%\n• Free Disk: {disk_free} GB"
        },
        {
            "title": "📉 Трехчасовой отчет",
            "interval_seconds": 10,
            "template": "Расширенный отчет:\n\nПользователи: {test}\n {disk_free} GB\nЗависших сессий: {stuck_sessions} "
        }
    ],
    "items": [
        {
            "name": "Temp папка",
            "type": "filesystem",
            "path": "D:/1",
            "limit": 10,
            "operator": ">",
            "current_state": "NORMAL",
            "last_alert_time": 0
        },
                {
            "name": "Teпка",
            "type": "filesystem",
            "path": "D:/2",
            "limit": 10,
            "operator": ">",
            "current_state": "NORMAL",
            "last_alert_time": 0
        },
        {
            "name": "Pending Orders",
            "type": "database",
            "variable": "pending_orders",
            "limit": 50,
            "operator": ">",
            "current_state": "NORMAL",
            "last_alert_time": 0
        },
        {
            "name": "Fly Orders",
            "type": "database",
            "variable": "stuck_sessions",
            "limit": 40,
            "operator": ">",
            "current_state": "NORMAL",
            "last_alert_time": 0
        }
    ]
}