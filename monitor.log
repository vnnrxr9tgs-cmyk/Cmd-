def get_db_results(self):
    import cx_Oracle

    try:
        # ==========================================
        # Подключение к Oracle
        # ==========================================
        dsn = cx_Oracle.makedsn(
            "localhost",       # host
            1521,              # port
            service_name="ORCLPDB1"
        )

        connection = cx_Oracle.connect(
            user="username",
            password="password",
            dsn=dsn
        )

        cursor = connection.cursor()

        # ==========================================================
        # 1️⃣ ЗАПРОС №1 — собираем строки в формат "1 20 2 25 3 34"
        # ==========================================================
        cursor.execute("""
            SELECT ID, VALUE
            FROM MY_TABLE
            ORDER BY ID
        """)

        rows1 = cursor.fetchall()

        # собираем в одну строку: значения через пробел
        table1_str = " ".join(str(item) for row in rows1 for item in row)

        table1 = rows1  # если нужно хранить отдельно как список кортежей

        # ==========================================================
        # 3️⃣ ЗАПРОС №3 — каждая строка отдельным уведомлением
        # ==========================================================
        cursor.execute("""
            SELECT COUNT_PLAYERS, TASK_NAME, AGE
            FROM GAME_STATS
        """)

        cols3 = [col[0].lower() for col in cursor.description]
        rows3 = cursor.fetchall()
        table3 = [dict(zip(cols3, r)) for r in rows3]

        summary_lines = []

        for row in table3:
            players = row.get("count_players", 0)
            task = row.get("task_name", "")
            age = row.get("age", "")

            formatted_string = (
                f"Игроков: {players}, "
                f"Пройдено задание: {task}, "
                f"Возраст: {age}"
            )

            # отдельное уведомление для каждой строки
            self.root.after(
                0,
                lambda m=formatted_string:
                self.notifier.show(
                    "📌 Запрос 3 — запись",
                    m,
                    False,
                    True
                )
            )

            summary_lines.append(formatted_string)

        connection.close()

        # ==========================================================
        # ЕДИНЫЙ RETURN
        # ==========================================================
        return {
            "table1": table1_str,           # "1 20 2 25 3 34"
            "table3": table3,               # список словарей
            "summary": "\n".join(summary_lines)  # строки с фразами
        }

    except Exception as e:
        print("Oracle error:", e)

        return {
            "table1": "",
            "table3": [],
            "summary": ""
        }




def get_db_results(self):
    import cx_Oracle

    try:
        # Подключение к Oracle
        dsn = cx_Oracle.makedsn("localhost", 1521, service_name="ORCLPDB1")
        connection = cx_Oracle.connect(user="username", password="password", dsn=dsn)
        cursor = connection.cursor()

        # ==========================================
        # ЗАПРОС 1 — ID и VALUE
        # ==========================================
        cursor.execute("SELECT ID, VALUE FROM MY_TABLE ORDER BY ID")
        rows1 = cursor.fetchall()
        
        # Формируем строку "1 20 2 25 3 34"
        table1_str = " ".join(str(item) for row in rows1 for item in row)
        
        # Формируем читаемый вид для уведомления
        table1_readable = "\n".join([f"ID: {row[0]}, VALUE: {row[1]}" for row in rows1])

        # === УВЕДОМЛЕНИЕ 1: ВСЯ ТАБЛИЦА TABLE1 ===
        self.root.after(0, lambda:
            self.notifier.show(
                "📊 Вся таблица MY_TABLE",
                table1_readable,
                False,
                True
            )
        )

        # ==========================================
        # ЗАПРОС 3 — GAME_STATS
        # ==========================================
        cursor.execute("SELECT COUNT_PLAYERS, TASK_NAME, AGE FROM GAME_STATS")
        cols3 = [col[0].lower() for col in cursor.description]
        rows3 = cursor.fetchall()
        table3 = [dict(zip(cols3, r)) for r in rows3]

        # === УВЕДОМЛЕНИЕ 2: ВСЯ ТАБЛИЦА TABLE3 ===
        all_table3_lines = []
        for row in table3:
            line = f"Игроков: {row['count_players']}, Задание: {row['task_name']}, Возраст: {row['age']}"
            all_table3_lines.append(line)
        
        all_table3_str = "\n".join(all_table3_lines)
        
        self.root.after(0, lambda:
            self.notifier.show(
                "📋 Вся таблица GAME_STATS",
                all_table3_str,
                False,
                True
            )
        )

        # === УВЕДОМЛЕНИЯ 3-N: КАЖДАЯ СТРОКА TABLE3 ===
        for i, row in enumerate(table3):
            formatted_string = (
                f"Запись #{i+1}:\n"
                f"👥 Игроков: {row['count_players']}\n"
                f"🎯 Задание: {row['task_name']}\n"
                f"🎂 Возраст: {row['age']}"
            )
            
            self.root.after(
                0,
                lambda idx=i, data=formatted_string:  # Сохраняем текущие значения
                self.notifier.show(
                    f"📌 Запрос 3 — строка {idx+1}",
                    data,
                    False,
                    True
                )
            )

        connection.close()

        # Возвращаем данные для других целей
        return {
            "table1": table1_str,
            "table3": table3,
            "summary": "\n".join(all_table3_lines)
        }

    except Exception as e:
        print("Oracle error:", e)
        return {"table1": "", "table3": [], "summary": ""}